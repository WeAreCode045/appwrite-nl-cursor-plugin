{
  "mcpServers": {
    "appwrite-docs": {
      "url": "https://mcp.appwrite.io/"
    },
    "appwrite-endpoint": {
      "command": "node",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/bin/sync-endpoint-mcp.mjs"
      ],
      "env": {
        "APPWRITE_DEFAULT_ENDPOINT": "${APPWRITE_ENDPOINT}"
      }
    },
    "appwrite-api": {
      "command": "bash",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/bin/appwrite-mcp.sh",
        "${workspaceFolder}"
      ],
      "env": {
        "APPWRITE_DEFAULT_ENDPOINT": "${APPWRITE_ENDPOINT}"
      }
    }
  }
}
